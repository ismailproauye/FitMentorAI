<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="UTF-8">
    <title>FitMentor AI - Smart Fitness Dashboard</title>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
        body { display: flex; height: 100vh; background-color: #0b111e; color: #94a3b8; overflow: hidden; }

        /* Sağ Yuxarı Künc Üçün Bildiriş (Toast) Stili */
        #toastContainer {
            position: fixed;
            top: 24px;
            right: 24px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 10px;
            pointer-events: none;
        }
        .toast {
            background: #131d31;
            color: #f8fafc;
            border: 1px solid #1e293b;
            padding: 14px 20px;
            border-radius: 12px;
            font-size: 14px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 280px;
            pointer-events: auto;
            animation: slideIn 0.3s ease, fadeOut 0.3s ease 2.7s forwards;
        }
        .toast.success { border-color: #10b981; background: #064e3b; color: #34d399; }
        .toast.error { border-color: #ef4444; background: #450a0a; color: #fca5a5; }

        @keyframes slideIn {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
        @keyframes fadeOut {
            to { opacity: 0; transform: translateY(-10px); }
        }

        /* Auth (Giriş / Qeydiyyat) Səhifəsi */
        #authContainer { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: #0b111e; display: flex; justify-content: center; align-items: center; z-index: 1000; }
        .auth-box { background: #131d31; border: 1px solid #1e293b; border-radius: 16px; padding: 32px; width: 100%; max-width: 400px; display: flex; flex-direction: column; gap: 20px; }
        .auth-title { color: #f8fafc; font-size: 22px; font-weight: 700; text-align: center; }
        .auth-switch { text-align: center; font-size: 13px; color: #94a3b8; cursor: pointer; }
        .auth-switch span { color: #10b981; font-weight: 600; }

        /* Əsas Dashboard */
        #appContainer { display: none; width: 100vw; height: 100vh; display: flex; }
        .sidebar { width: 250px; height: 100vh; background: #0f172a; padding: 24px 16px; border-right: 1px solid #1e293b; display: flex; flex-direction: column; justify-content: space-between; flex-shrink: 0; }
        .brand { display: flex; align-items: center; gap: 10px; color: #10b981; font-weight: 700; font-size: 18px; margin-bottom: 24px; }
        .menu-list { list-style: none; display: flex; flex-direction: column; gap: 8px; }
        .menu-item { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-radius: 12px; font-size: 14px; font-weight: 500; cursor: pointer; transition: all 0.2s; }
        .menu-item:hover { color: #f8fafc; background: #1e293b; }
        .menu-item.active { background: #064e3b; color: #34d399; }
        
        .logout { color: #ef4444; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); cursor: pointer; display: flex; align-items: center; gap: 10px; padding: 14px 16px; font-size: 14px; font-weight: 600; border-radius: 12px; transition: all 0.2s; }
        .logout:hover { background: #ef4444; color: #ffffff; }

        .main-wrapper { flex: 1; display: flex; flex-direction: column; height: 100vh; overflow: hidden; }
        .page-header { padding: 24px 32px 16px 32px; color: #f8fafc; font-size: 22px; font-weight: 700; }

        .content-area { flex: 1; padding: 0 32px 24px 32px; display: none; overflow-y: auto; }
        .content-area.active { display: flex; gap: 20px; }

        /* Çat Ekranı */
        #tab-chat.active { height: calc(100vh - 80px); }
        .chat-card { flex: 1; background: #131d31; border: 1px solid #1e293b; border-radius: 16px; display: flex; flex-direction: column; padding: 20px; }
        .chat-box { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 16px; padding-right: 8px; }

        .message { max-width: 80%; padding: 14px 18px; border-radius: 14px; font-size: 14px; line-height: 1.5; word-break: break-word; }
        .message.ai { background: #1a263d; border: 1px solid #283754; color: #e2e8f0; align-self: flex-start; }
        .message.user { background: #064e3b; border: 1px solid #059669; color: #e2e8f0; align-self: flex-end; }
        
        .message p, .qida-result p, .workout-result p { margin-bottom: 8px; }
        .message ul, .qida-result ul, .workout-result ul { margin-left: 18px; margin-bottom: 8px; }
        .message h3, .qida-result h3, .workout-result h3 { color: #34d399; margin: 12px 0 6px 0; font-size: 16px; }

        .input-bar { margin-top: 16px; display: flex; gap: 10px; align-items: center; }
        .input-bar input[type="text"] { flex: 1; background: #0b111e; border: 1px solid #283754; border-radius: 10px; padding: 14px 18px; color: #f8fafc; font-size: 14px; outline: none; }
        .file-upload-btn { background: #1a263d; border: 1px solid #283754; border-radius: 10px; padding: 12px 14px; color: #10b981; cursor: pointer; display: flex; align-items: center; justify-content: center; }
        .send-btn { background: #10b981; color: #064e3b; border: none; border-radius: 10px; padding: 14px 24px; font-weight: 700; font-size: 14px; cursor: pointer; }

        .history-card { width: 280px; background: #131d31; border: 1px solid #1e293b; border-radius: 16px; padding: 16px; display: flex; flex-direction: column; gap: 14px; }
        .new-chat-btn { background: #10b981; color: #064e3b; border: none; border-radius: 10px; padding: 12px; font-weight: 700; font-size: 14px; cursor: pointer; text-align: center; }
        .history-title { font-size: 12px; font-weight: 700; color: #64748b; letter-spacing: 0.5px; }
        .history-list { list-style: none; overflow-y: auto; flex: 1; display: flex; flex-direction: column; gap: 8px; }
        .history-item { padding: 12px; background: #0b111e; border: 1px solid #1e293b; border-radius: 10px; font-size: 13px; color: #94a3b8; cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .history-item:hover, .history-item.active { border-color: #10b981; color: #f8fafc; background: #1a263d; }

        /* Kartlar və Formalar */
        .card { background: #131d31; border: 1px solid #1e293b; border-radius: 16px; padding: 24px; color: #f8fafc; width: 100%; max-width: 850px; display: flex; flex-direction: column; gap: 16px; }
        .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
        .form-group { display: flex; flex-direction: column; gap: 8px; }
        .form-group.full { grid-column: span 2; }
        .form-group label { font-size: 14px; color: #94a3b8; }
        .form-group input, .form-group select { background: #0b111e; border: 1px solid #283754; border-radius: 10px; padding: 12px 16px; color: #f8fafc; font-size: 14px; outline: none; }
        .form-group input:focus { border-color: #10b981; }
        .save-btn { background: #10b981; color: #064e3b; border: none; border-radius: 10px; padding: 14px; font-weight: 700; font-size: 14px; cursor: pointer; }

        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; width: 100%; }
        .stat-box { background: #0b111e; border: 1px solid #1e293b; border-radius: 12px; padding: 20px; text-align: center; }
        .stat-value { font-size: 28px; font-weight: 700; color: #34d399; margin-top: 8px; }

        .qida-container, .workout-container { display: flex; gap: 20px; width: 100%; }
        .qida-result, .workout-result { flex: 1; background: #0b111e; border: 1px solid #1e293b; border-radius: 12px; padding: 20px; color: #e2e8f0; font-size: 14px; line-height: 1.6; min-height: 200px; max-height: 450px; overflow-y: auto; }
    </style>
</head>
<body>

    <!-- Sağ Yuxarı Künc Bildirişləri Üçün Qutu -->
    <div id="toastContainer"></div>

    <!-- Giriş / Qeydiyyat Ekranı -->
    <div id="authContainer">
        <div class="auth-box">
            <div class="auth-title" id="authTitle">FitMentor AI - Giriş</div>
            <form id="authForm" onsubmit="handleAuth(event)">
                <div class="form-group" id="regFields" style="display: none; gap: 12px;">
                    <div>
                        <label>Ad:</label>
                        <input type="text" id="auth_first_name">
                    </div>
                    <div>
                        <label>Soyad:</label>
                        <input type="text" id="auth_last_name">
                    </div>
                </div>
                <div class="form-group" style="margin-top: 10px;">
                    <label>E-poçt (Email):</label>
                    <input type="email" id="auth_email" required>
                </div>
                <div class="form-group" style="margin-top: 10px;">
                    <label>Şifrə:</label>
                    <input type="password" id="auth_password" required>
                </div>
                <button type="submit" class="save-btn" id="authBtn" style="margin-top: 20px; width: 100%;">Daxil Ol</button>
            </form>
            <div class="auth-switch" id="authSwitchText" onclick="toggleAuthMode()">
                Hesabınız yoxdur? <span>Qeydiyyatdan keçin</span>
            </div>
        </div>
    </div>

    <!-- Əsas Panel -->
    <div id="appContainer" style="display: none;">
        <div class="sidebar">
            <div>
                <div class="brand">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                    FitMentor AI
                </div>
                <ul class="menu-list">
                    <li class="menu-item" onclick="switchTab('profile', this)">👤 Profil Məlumatları</li>
                    <li class="menu-item" onclick="switchTab('overview', this)">📊 Ümumi İcmal</li>
                    <li class="menu-item" onclick="switchTab('meal', this)">🍽️ AI Qida Analizi</li>
                    <li class="menu-item" onclick="switchTab('meal-plan', this)">🥗 Gündəlik Qida Proqramı</li>
                    <li class="menu-item" onclick="switchTab('workout', this)">🏋️ Məşq Proqramı</li>
                    <li class="menu-item active" onclick="switchTab('chat', this)">💬 FitMentor AI Çat</li>
                </ul>
            </div>
            <div class="logout" onclick="handleLogout()">🚪 Çıxış Et</div>
        </div>

        <div class="main-wrapper">
            <div class="page-header" id="pageTitle">FitMentor AI Məsləhətçi</div>

            <!-- Çat -->
            <div id="tab-chat" class="content-area active">
                <div class="chat-card">
                    <div class="chat-box" id="chatBox"></div>
                    <div class="input-bar">
                        <label class="file-upload-btn" title="Şəkil əlavə et">
                            📷 <input type="file" id="imageInput" accept="image/*" style="display:none;">
                        </label>
                        <input type="text" id="userInput" placeholder="Mesajınızı yazın..." onkeypress="if(event.key==='Enter') sendMessage()">
                        <button class="send-btn" onclick="sendMessage()">Göndər ➔</button>
                    </div>
                </div>
                <div class="history-card">
                    <button class="new-chat-btn" onclick="startNewChat()">+ Yeni Söhbət</button>
                    <div class="history-title">KÖHNƏ ÇATLAR</div>
                    <ul class="history-list" id="historyList"></ul>
                </div>
            </div>

            <!-- Profil -->
            <div id="tab-profile" class="content-area">
                <div class="card">
                    <h3>Şəxsi Məlumatlar</h3>
                    <form id="profileForm" onsubmit="updateProfile(event)">
                        <div class="form-grid">
                            <div class="form-group">
                                <label>Ad:</label>
                                <input type="text" id="p_first_name" required>
                            </div>
                            <div class="form-group">
                                <label>Soyad:</label>
                                <input type="text" id="p_last_name" required>
                            </div>
                            <div class="form-group full">
                                <label>E-poçt (Email):</label>
                                <input type="email" id="p_email" required>
                            </div>
                            <div class="form-group">
                                <label>Yaş:</label>
                                <input type="number" id="p_age" required>
                            </div>
                            <div class="form-group">
                                <label>Cins:</label>
                                <select id="p_gender">
                                    <option value="male">Kişi</option>
                                    <option value="female">Qadın</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Boy (sm):</label>
                                <input type="number" step="0.1" id="p_height" required>
                            </div>
                            <div class="form-group">
                                <label>Çəki (kq):</label>
                                <input type="number" step="0.1" id="p_weight" required>
                            </div>
                        </div>
                        <button type="submit" class="save-btn" style="margin-top: 12px; width: 100%;">Məlumatları Yenilə</button>
                    </form>
                </div>
            </div>

            <!-- İcmal -->
            <div id="tab-overview" class="content-area">
                <div class="card">
                    <h3>Gündəlik Göstəriciləriniz</h3>
                    <div class="stats-grid">
                        <div class="stat-box">
                            <div style="font-size: 14px;">Bədən Kütlə İndeksi (BMI)</div>
                            <div class="stat-value" id="bmiVal">--</div>
                        </div>
                        <div class="stat-box">
                            <div style="font-size: 14px;">Gündəlik Kalori Tələbatı</div>
                            <div class="stat-value" id="calVal">-- kcal</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Qida Analizi -->
            <div id="tab-meal" class="content-area">
                <div class="card" style="max-width: 1000px;">
                    <h3>AI Qida və Kalori Analizi</h3>
                    <p style="font-size: 14px; color: #94a3b8;">Yeməyinizin şəklini yükləyin və ya nə yediyinizi mətn olaraq yazın.</p>
                    <div class="qida-container">
                        <div style="flex: 1; display: flex; flex-direction: column; gap: 12px;">
                            <div class="form-group">
                                <label>Yemək Şəkli:</label>
                                <input type="file" id="qidaImage" accept="image/*">
                            </div>
                            <div class="form-group">
                                <label>Və ya Təsvir Edin:</label>
                                <input type="text" id="qidaText" placeholder="Məsələn: 200q qızardılmış toyuq sine əti və düyü">
                            </div>
                            <button class="save-btn" onclick="analyzeMeal()">Analiz Et 🔍</button>
                        </div>
                        <div class="qida-result" id="qidaResult">Analiz nəticəsi burada görünəcək...</div>
                    </div>
                </div>
            </div>

            <!-- Gündəlik Qida Proqramı (YENİ ƏLAVƏ OLUNAN BÖLMƏ) -->
            <div id="tab-meal-plan" class="content-area">
                <div class="card" style="max-width: 1000px;">
                    <h3>Fərdiləşdirilmiş Gündəlik Qida Proqramı</h3>
                    <p style="font-size: 14px; color: #94a3b8;">Kalori ehtiyacınıza və məqsədinizə uyğun olaraq AI tərəfindən hazırlanan menyu.</p>
                    <div class="workout-container">
                        <div style="flex: 1; display: flex; flex-direction: column; gap: 12px;">
                            <div class="form-group">
                                <label>Əsas Məqsəd:</label>
                                <select id="mealGoal">
                                    <option value="Çəki saxlamaq">Çəki saxlamaq</option>
                                    <option value="Arıqlamaq / Çəki atmaq">Arıqlamaq / Çəki atmaq</option>
                                    <option value="Əzələ kütləsi qazanmaq">Əzələ kütləsi qazanmaq</option>
                                </select>
                            </div>
                            <button class="save-btn" onclick="generateMealPlan()">Proqramı Yarat 🍏</button>
                        </div>
                        <div class="workout-result" id="mealPlanResult">Qida proqramınız burada görünəcək...</div>
                    </div>
                </div>
            </div>

            <!-- Məşq Proqramı -->
            <div id="tab-workout" class="content-area">
                <div class="card" style="max-width: 1000px;">
                    <h3>Fərdiləşdirilmiş Məşq Proqramı</h3>
                    <p style="font-size: 14px; color: #94a3b8;">Harada və həftədə neçə gün məşq edəcəyinizi seçin, AI sizin üçün xüsusi proqram hazırlasın.</p>
                    <div class="workout-container">
                        <div style="flex: 1; display: flex; flex-direction: column; gap: 12px;">
                            <div class="form-group">
                                <label>Məşq Yeri:</label>
                                <select id="workoutLocation">
                                    <option value="Evdə">Evdə</option>
                                    <option value="İdman Zalında (Gym)">İdman Zalında (Gym)</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Həftəlik Tezlik:</label>
                                <select id="workoutDays">
                                    <option value="3">Həftədə 3 gün</option>
                                    <option value="4">Həftədə 4 gün</option>
                                    <option value="5">Həftədə 5 gün</option>
                                    <option value="6">Həftədə 6 gün</option>
                                </select>
                            </div>
                            <button class="save-btn" onclick="generateWorkoutPlan()">Proqramı Yarat 🚀</button>
                        </div>
                        <div class="workout-result" id="workoutResult">Məşq proqramınız burada görünəcək...</div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <script>
        function showToast(message, type = 'success') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            
            const icon = type === 'success' ? '✅' : '⚠️';
            toast.innerHTML = `<span>${icon}</span> <span>${message}</span>`;
            
            container.appendChild(toast);
            
            setTimeout(() => {
                toast.remove();
            }, 3000);
        }

        let isRegisterMode = false;
        let currentChatId = null;

        function toggleAuthMode() {
            isRegisterMode = !isRegisterMode;
            const title = document.getElementById('authTitle');
            const btn = document.getElementById('authBtn');
            const switchText = document.getElementById('authSwitchText');
            const regFields = document.getElementById('regFields');

            if (isRegisterMode) {
                title.innerText = 'FitMentor AI - Qeydiyyat';
                btn.innerText = 'Qeydiyyatdan Keç';
                switchText.innerHTML = 'Artıq hesabınız var? <span>Daxil olun</span>';
                regFields.style.display = 'grid';
            } else {
                title.innerText = 'FitMentor AI - Giriş';
                btn.innerText = 'Daxil Ol';
                switchText.innerHTML = 'Hesabınız yoxdur? <span>Qeydiyyatdan keçin</span>';
                regFields.style.display = 'none';
            }
        }

        async function handleAuth(e) {
            e.preventDefault();
            const email = document.getElementById('auth_email').value;
            const password = document.getElementById('auth_password').value;
            
            const formData = new FormData();
            formData.append('email', email);
            formData.append('password', password);

            let url = '/auth/login';
            if (isRegisterMode) {
                url = '/auth/register';
                formData.append('first_name', document.getElementById('auth_first_name').value);
                formData.append('last_name', document.getElementById('auth_last_name').value);
            }

            try {
                const res = await fetch(url, { method: 'POST', body: formData });
                const data = await res.json();
                
                if (res.ok) {
                    showToast(data.message, 'success');
                    document.getElementById('authContainer').style.display = 'none';
                    document.getElementById('appContainer').style.display = 'flex';
                    initApp();
                } else {
                    showToast(data.detail || 'Xəta baş verdi', 'error');
                }
            } catch (err) {
                showToast('Serverlə əlaqə qurulmadı.', 'error');
            }
        }

        function handleLogout() {
            document.getElementById('appContainer').style.display = 'none';
            document.getElementById('authContainer').style.display = 'flex';
            showToast('Hesabdan çıxış edildi.', 'success');
        }

        function switchTab(tabName, el) {
            document.querySelectorAll('.menu-item').forEach(i => i.classList.remove('active'));
            document.querySelectorAll('.content-area').forEach(c => c.classList.remove('active'));

            if (el) el.classList.add('active');
            document.getElementById(`tab-${tabName}`).classList.add('active');

            const titles = {
                'profile': 'Profil Məlumatları',
                'overview': 'Ümumi İcmal',
                'meal': 'AI Qida Analizi',
                'meal-plan': 'Gündəlik Qida Proqramı',
                'workout': 'Məşq Proqramı',
                'chat': 'FitMentor AI Məsləhətçi'
            };
            document.getElementById('pageTitle').innerText = titles[tabName];

            if (tabName === 'profile' || tabName === 'overview') {
                fetchProfileData();
            }
        }

        async function fetchProfileData() {
            const res = await fetch('/profile');
            const data = await res.json();
            
            document.getElementById('p_first_name').value = data.profile.first_name || '';
            document.getElementById('p_last_name').value = data.profile.last_name || '';
            document.getElementById('p_email').value = data.profile.email || '';
            document.getElementById('p_age').value = data.profile.age;
            document.getElementById('p_gender').value = data.profile.gender;
            document.getElementById('p_height').value = data.profile.height_cm;
            document.getElementById('p_weight').value = data.profile.weight_kg;

            document.getElementById('bmiVal').innerText = data.bmi;
            document.getElementById('calVal').innerText = `${data.daily_calories} kcal`;
        }

        async function updateProfile(e) {
            e.preventDefault();
            const formData = new FormData();
            formData.append('first_name', document.getElementById('p_first_name').value);
            formData.append('last_name', document.getElementById('p_last_name').value);
            formData.append('email', document.getElementById('p_email').value);
            formData.append('age', document.getElementById('p_age').value);
            formData.append('gender', document.getElementById('p_gender').value);
            formData.append('height_cm', document.getElementById('p_height').value);
            formData.append('weight_kg', document.getElementById('p_weight').value);

            const res = await fetch('/profile/update', { method: 'POST', body: formData });
            if (res.ok) {
                showToast('Profil məlumatları uğurla yeniləndi!', 'success');
                fetchProfileData();
            } else {
                showToast('Yenilənmə zamanı xəta baş verdi.', 'error');
            }
        }

        async function analyzeMeal() {
            const fileInput = document.getElementById('qidaImage');
            const textInput = document.getElementById('qidaText');
            const resultBox = document.getElementById('qidaResult');

            if (!fileInput.files[0] && !textInput.value.trim()) {
                showToast('Zəhmət olmasa şəkil yükləyin və ya mətn yazın.', 'error');
                return;
            }

            resultBox.innerText = 'Analiz edilir, zəhmət olmasa gözləyin...';

            const formData = new FormData();
            if (textInput.value.trim()) {
                formData.append('message', `Yemək analizi: ${textInput.value.trim()}`);
            } else {
                formData.append('message', 'Bu şəkildəki yeməyi analiz et.');
            }
            if (fileInput.files[0]) formData.append('image', fileInput.files[0]);

            try {
                const res = await fetch('/ai-chat', { method: 'POST', body: formData });
                const data = await res.json();
                resultBox.innerHTML = marked.parse(data.reply);
            } catch (err) {
                resultBox.innerText = 'Analiz zamanı xəta baş verdi.';
            }
        }

        async function generateMealPlan() {
            const goal = document.getElementById('mealGoal').value;
            const resultBox = document.getElementById('mealPlanResult');

            resultBox.innerText = 'Qida proqramınız hazırlanır, zəhmət olmasa gözləyin...';

            const formData = new FormData();
            formData.append('goal', goal);

            try {
                const res = await fetch('/generate-meal-plan', { method: 'POST', body: formData });
                const data = await res.json();
                resultBox.innerHTML = marked.parse(data.meal_plan);
            } catch (err) {
                resultBox.innerText = 'Qida proqramı yaradılarkən xəta baş verdi.';
            }
        }

        async function generateWorkoutPlan() {
            const location = document.getElementById('workoutLocation').value;
            const days = document.getElementById('workoutDays').value;
            const resultBox = document.getElementById('workoutResult');

            resultBox.innerText = 'Məşq proqramı hazırlanır, zəhmət olmasa gözləyin...';

            const formData = new FormData();
            formData.append('location', location);
            formData.append('days_per_week', days);

            try {
                const res = await fetch('/generate-workout', { method: 'POST', body: formData });
                const data = await res.json();
                resultBox.innerHTML = marked.parse(data.workout_plan);
            } catch (err) {
                resultBox.innerText = 'Məşq proqramı yaradılarkən xəta baş verdi.';
            }
        }

        async function initApp() {
            await loadChats();
            startNewChat();
            fetchProfileData();
        }

        async function loadChats() {
            const res = await fetch('/chats');
            const chats = await res.json();
            const list = document.getElementById('historyList');
            list.innerHTML = '';
            
            chats.forEach(chat => {
                const li = document.createElement('li');
                li.className = `history-item ${chat.id === currentChatId ? 'active' : ''}`;
                li.innerText = chat.title;
                li.onclick = () => selectChat(chat.id);
                list.appendChild(li);
            });
        }

        function startNewChat() {
            currentChatId = null;
            const chatBox = document.getElementById('chatBox');
            chatBox.innerHTML = `
                <div class="message ai">
                    Salam! Mən sizin şəxsi fitnes və qidalanma məsləhətçinizəm. Necəsiniz? Bu gün sizə necə kömək edə bilərəm?
                </div>
            `;
            loadChats();
        }

        async function selectChat(chatId) {
            currentChatId = chatId;
            const res = await fetch(`/chats/${chatId}`);
            const data = await res.json();
            
            const chatBox = document.getElementById('chatBox');
            chatBox.innerHTML = '';

            data.messages.forEach(msg => {
                appendMessage(msg.text, msg.sender, msg.image);
            });
            await loadChats();
        }

        function appendMessage(text, sender, hasImage = false) {
            const chatBox = document.getElementById('chatBox');
            const div = document.createElement('div');
            div.className = `message ${sender}`;
            
            let htmlContent = sender === 'ai' ? marked.parse(text) : text;
            if (hasImage) {
                htmlContent = "📷 <i>[Şəkil əlavə olundu]</i><br>" + htmlContent;
            }
            div.innerHTML = htmlContent;
            chatBox.appendChild(div);
            chatBox.scrollTop = chatBox.scrollHeight;
        }

        async function sendMessage() {
            const input = document.getElementById('userInput');
            const imageInput = document.getElementById('imageInput');
            const text = input.value.trim();
            const file = imageInput.files[0];

            if (!text && !file) return;

            appendMessage(text || "Şəkil göndərildi", 'user', !!file);
            
            const formData = new FormData();
            if (currentChatId) formData.append('chat_id', currentChatId);
            if (text) formData.append('message', text);
            if (file) formData.append('image', file);

            input.value = '';
            imageInput.value = '';

            try {
                const res = await fetch('/ai-chat', { method: 'POST', body: formData });
                const data = await res.json();
                currentChatId = data.chat_id;
                appendMessage(data.reply, 'ai');
                await loadChats();
            } catch (err) {
                appendMessage("Xəta baş verdi.", 'ai');
            }
        }
    </script>
</body>
</html>
